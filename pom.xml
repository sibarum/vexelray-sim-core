<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.vexelray.sim</groupId>
    <artifactId>vexelray-sim-core-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>vexelray-sim-core</name>
    <description>
        What the VexelRay simulations share: the infrastructure every experiment pays for once, not any technique.
        The pure half is in -core, the stack's half in -gui. vexelray-sim-fluid, vexelray-sim-rigid and
        vexelray-sim-physics build on it.
    </description>

    <modules>
        <!-- Kernels written by hand in SupirVast IR, a step as data, and the budgeted integer clock. vastir only. -->
        <module>vexelray-sim-core</module>
        <!-- On the VexelRay stack: the work budget, the orbit camera, and the widgets a demo's control panel is made of. -->
        <module>vexelray-sim-core-gui</module>
    </modules>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- The stack, installed to the local .m2 from the sibling checkouts. -->
        <supirvast.version>0.2.0-SNAPSHOT</supirvast.version>
        <vexelray.gui.version>0.1.0-SNAPSHOT</vexelray.gui.version>

        <junit.version>5.11.4</junit.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>dev.vexelray.sim</groupId>
                <artifactId>vexelray-sim-core</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>dev.supirvast</groupId>
                <artifactId>vastir</artifactId>
                <version>${supirvast.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.vexelray.gui</groupId>
                <artifactId>vexelray-gui-core</artifactId>
                <version>${vexelray.gui.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.vexelray.gui</groupId>
                <artifactId>vexelray-gui-widget</artifactId>
                <version>${vexelray.gui.version}</version>
            </dependency>

            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <!-- Explicit release on the plugin as well as the property, so IDEs pick up the Java 25
                         language level reliably. Same as the sibling repos. -->
                    <configuration>
                        <target>${maven.compiler.release}</target>
                        <release>${maven.compiler.release}</release>
                        <compilerArgs>
                            <arg>-Xdoclint:reference,syntax</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.2</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
